# /opt/payroll-hookangles/.env   (chmod 600, owner payroll). Read by systemd: no quotes, no `export`.
# Generate the key with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_HTTPS=1
DJANGO_ALLOWED_HOSTS=api.payroll.hookangles.com,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.payroll.hookangles.com
DATABASE_URL=postgres://payroll:change-me-db-password@127.0.0.1:5432/payroll
DEMO_PASSWORD=demo-pass-123
# Shared with the web UI (its PROXY_IP_SECRET): lets the API rate-limit by the real visitor IP.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PROXY_IP_SECRET=change-me-shared-with-the-ui
